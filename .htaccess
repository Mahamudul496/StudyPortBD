Options -Indexes
ServerSignature Off

# Hide error/database details from visitors in production.
<IfModule mod_php.c>
  php_flag display_errors Off
  php_value error_reporting 0
</IfModule>
<IfModule mod_php7.c>
  php_flag display_errors Off
</IfModule>
<IfModule mod_php8.c>
  php_flag display_errors Off
</IfModule>

# Block direct web access to sensitive files by name, anywhere in the site.
<IfModule mod_authz_core.c>
  <FilesMatch "^(database\.sql|database\.php|schema\.sql|\.env)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(database\.sql|database\.php|schema\.sql|\.env)$">
    Deny from all
  </FilesMatch>
</IfModule>

# Basic security headers.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
